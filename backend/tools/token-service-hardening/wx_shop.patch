+"""Local token-service security: AES-GCM envelopes and lifetime process ownership.
+
+Keys are supplied out of band via TOKEN_ENCRYPTION_KEY_FILE (JSON map of
+version -> base64 32-byte key). Never creates or silently replaces keys/data.
+"""
+import base64
+import json
+import os
+import secrets
+from pathlib import Path
+from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+
+
+class LegacyPlaintextError(RuntimeError):
+    pass
+
+
+class SecureJSON:
+    def __init__(self, context):
+        key_file = os.environ.get("TOKEN_ENCRYPTION_KEY_FILE", "")
+        self.version = os.environ.get("TOKEN_KEY_VERSION", "")
+        self.tenant = os.environ.get("TOKEN_TENANT_ID", "")
+        if not key_file or not self.version or not self.tenant:
+            raise RuntimeError("需要 TOKEN_ENCRYPTION_KEY_FILE / TOKEN_KEY_VERSION / TOKEN_TENANT_ID")
+        try:
+            self.keys = json.loads(Path(key_file).read_text(encoding="utf-8"))
+            for key in self.keys.values():
+                if len(base64.b64decode(key, validate=True)) != 32:
+                    raise ValueError()
+            if self.version not in self.keys:
+                raise ValueError()
+        except Exception:
+            raise RuntimeError("令牌加密密钥文件无效") from None
+        self.context = self.tenant + ":" + context
+
+    def read(self, path):
+        envelope = json.loads(Path(path).read_text(encoding="utf-8"))
+        if not isinstance(envelope, dict) or envelope.get("format") != "token-aesgcm-v1":
+            raise LegacyPlaintextError("拒绝读取旧明文凭据；请停服后执行显式加密迁移")
+        try:
+            version = envelope["key_version"]
+            aad = (self.context + ":" + version).encode()
+            raw = AESGCM(base64.b64decode(self.keys[version], validate=True)).decrypt(
+                base64.b64decode(envelope["nonce"], validate=True),
+                base64.b64decode(envelope["ciphertext"], validate=True), aad)
+            return json.loads(raw)
+        except Exception:
+            raise RuntimeError("令牌密文不可读取：密钥、版本、身份上下文或完整性不匹配") from None
+
+    def write(self, path, payload):
+        path = Path(path)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        nonce = secrets.token_bytes(12)
+        aad = (self.context + ":" + self.version).encode()
+        ciphertext = AESGCM(base64.b64decode(self.keys[self.version], validate=True)).encrypt(
+            nonce, json.dumps(payload, ensure_ascii=False).encode(), aad)
+        envelope = {"format": "token-aesgcm-v1", "key_version": self.version,
+                    "nonce": base64.b64encode(nonce).decode(),
+                    "ciphertext": base64.b64encode(ciphertext).decode()}
+        tmp = path.with_name(path.name + "." + secrets.token_hex(8) + ".tmp")
+        try:
+            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+            with os.fdopen(fd, "w", encoding="utf-8") as stream:
+                json.dump(envelope, stream)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(tmp, path)
+        finally:
+            tmp.unlink(missing_ok=True)
+
+
+class ProcessOwner:
+    """OS-held lifetime lock: second owner fails closed; crash releases lock.
+
+    Shared local filesystem only. All service instances for the same app must
+    share this path; multi-host/network-filesystem deployment is unsupported.
+    """
+    def __init__(self, path):
+        self.path = Path(path)
+        self.stream = None
+
+    def acquire(self):
+        if self.stream is not None:
+            return self
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        stream = self.path.open("a+b")
+        stream.seek(0, 2)
+        if stream.tell() == 0:
+            stream.write(b"0")
+            stream.flush()
+        stream.seek(0)
+        try:
+            if os.name == "nt":
+                import msvcrt
+                msvcrt.locking(stream.fileno(), msvcrt.LK_NBLCK, 1)
+            else:
+                import fcntl
+                fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError:
+            stream.close()
+            raise RuntimeError("同一应用已有令牌服务进程；请复用唯一托管入口") from None
+        self.stream = stream
+        return self
+
+    def close(self):
+        if self.stream is not None:
+            if os.name == "nt":
+                import msvcrt
+                self.stream.seek(0)
+                msvcrt.locking(self.stream.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                import fcntl
+                fcntl.flock(self.stream.fileno(), fcntl.LOCK_UN)
+            self.stream.close()
+            self.stream = None
