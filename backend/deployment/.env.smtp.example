# 复制为.env.smtp.local，仅在本地/服务器填写。不要提交真实账号或授权码。
YULIANG_SMTP_HOST=smtp.example.invalid
YULIANG_SMTP_PORT=465
YULIANG_SMTP_SECURITY=ssl
YULIANG_SMTP_USERNAME=your-smtp-account
YULIANG_SMTP_PASSWORD=
YULIANG_SMTP_FROM=sender@example.invalid
# 仅本地真实收件验收脚本使用，业务接口不读取此字段决定收件人。
YULIANG_SMTP_TEST_TO=receiver@example.invalid
