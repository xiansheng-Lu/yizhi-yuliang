+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+from cache.security import SecureJSON, ProcessOwner, LegacyPlaintextError
+from tests.security_fixture import KEY_FILE
+
+
+class SecurityTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.path = Path(self.tmp.name) / "token.json"
+        env = patch.dict(os.environ, TOKEN_ENCRYPTION_KEY_FILE=str(KEY_FILE),
+                         TOKEN_KEY_VERSION="test-v1", TOKEN_TENANT_ID="tenant-one")
+        env.start()
+        self.addCleanup(env.stop)
+
+    def test_roundtrip_no_plaintext(self):
+        cipher = SecureJSON("wxshop:app-one")
+        cipher.write(self.path, {"access_token": "synthetic-token", "refresh_token": "synthetic-refresh"})
+        raw = self.path.read_text()
+        self.assertNotIn("synthetic-token", raw)
+        self.assertNotIn("synthetic-refresh", raw)
+        self.assertEqual(json.loads(raw)["key_version"], "test-v1")
+        self.assertEqual(cipher.read(self.path)["access_token"], "synthetic-token")
+
+    def test_wrong_tenant_rejected(self):
+        SecureJSON("app-one").write(self.path, {"token": "synthetic"})
+        with patch.dict(os.environ, TOKEN_TENANT_ID="tenant-two"):
+            with self.assertRaises(RuntimeError):
+                SecureJSON("app-one").read(self.path)
+
+    def test_wrong_application_rejected(self):
+        SecureJSON("app-one").write(self.path, {"token": "synthetic"})
+        with self.assertRaises(RuntimeError):
+            SecureJSON("app-two").read(self.path)
+
+    def test_tampering_rejected(self):
+        cipher = SecureJSON("app")
+        cipher.write(self.path, {"token": "synthetic"})
+        data = json.loads(self.path.read_text())
+        data["ciphertext"] = "AAAA"
+        self.path.write_text(json.dumps(data))
+        with self.assertRaises(RuntimeError):
+            cipher.read(self.path)
+
+    def test_unknown_version_rejected(self):
+        cipher = SecureJSON("app")
+        cipher.write(self.path, {"token": "synthetic"})
+        data = json.loads(self.path.read_text())
+        data["key_version"] = "missing"
+        self.path.write_text(json.dumps(data))
+        with self.assertRaises(RuntimeError):
+            cipher.read(self.path)
+
+    def test_legacy_plaintext_requires_explicit_migration(self):
+        raw = '{"token":"synthetic"}'
+        self.path.write_text(raw)
+        with self.assertRaises(LegacyPlaintextError):
+            SecureJSON("app").read(self.path)
+        self.assertEqual(self.path.read_text(), raw)
+
+    def test_missing_key_configuration_rejected(self):
+        with patch.dict(os.environ, TOKEN_ENCRYPTION_KEY_FILE=""):
+            with self.assertRaises(RuntimeError):
+                SecureJSON("app")
+
+    def test_new_nonce_for_each_write(self):
+        cipher = SecureJSON("app")
+        cipher.write(self.path, {"token": "synthetic"})
+        old = self.path.read_text()
+        cipher.write(self.path, {"token": "synthetic"})
+        self.assertNotEqual(self.path.read_text(), old)
+
+    def test_process_owner_exclusion_and_release(self):
+        lock = self.path.with_suffix(".lock")
+        owner = ProcessOwner(lock).acquire()
+        script = "from cache.security import ProcessOwner; import sys; ProcessOwner(sys.argv[1]).acquire()"
+        try:
+            result = subprocess.run([sys.executable, "-c", script, str(lock)],
+                                    capture_output=True, timeout=10)
+            self.assertNotEqual(result.returncode, 0)
+            self.assertIn("RuntimeError", result.stderr.decode())
+        finally:
+            owner.close()
+        result = subprocess.run([sys.executable, "-c", script, str(lock)], capture_output=True, timeout=10)
+        self.assertEqual(result.returncode, 0, result.stderr.decode())
+
+    def test_key_initialization_and_offline_migration(self):
+        from tools.manage_security import init_key, migrate
+        key = Path(self.tmp.name) / "new-keys.json"
+        init_key(key, "v2")
+        with self.assertRaises(FileExistsError):
+            init_key(key, "v2")
+        self.path.write_text('{"token":"synthetic", "appid":"app"}')
+        with patch.dict(os.environ, TOKEN_ENCRYPTION_KEY_FILE=str(key), TOKEN_KEY_VERSION="v2"):
+            migrate(self.path, "access-token:app", str(self.path) + ".lock")
+            self.assertEqual(SecureJSON("access-token:app").read(self.path)["token"], "synthetic")
+            self.assertNotIn("synthetic", self.path.read_text())
+
+    def test_migration_refuses_live_owner_without_touching_file(self):
+        from tools.manage_security import migrate
+        raw = '{"token":"synthetic"}'
+        self.path.write_text(raw)
+        owner = ProcessOwner(str(self.path) + ".lock").acquire()
+        try:
+            with self.assertRaises(RuntimeError):
+                migrate(self.path, "app", str(self.path) + ".lock")
+            self.assertEqual(self.path.read_text(), raw)
+        finally:
+            owner.close()
+
+    def test_service_refuses_startup_without_api_key(self):
+        root = Path(__file__).resolve().parents[1]
+        service = next((root / "services").glob("*_token_service.py"))
+        env = dict(os.environ)
+        env.update(ADQ_TOKEN_API_KEY="", WX_TOKEN_API_KEY="")
+        result = subprocess.run([sys.executable, str(service)], env=env,
+                                capture_output=True, timeout=10)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn(b"TOKEN_API_KEY", result.stderr)
