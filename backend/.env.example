# 所有值均是本地占位示例；真实.env不提交，不可照用在生产。
YULIANG_ENVIRONMENT=local
YULIANG_DATABASE_URL=postgresql+psycopg://app_login:replace-with-local-app-password@127.0.0.1:5432/yizhi
YULIANG_AUTH_DATABASE_URL=postgresql+psycopg://app_auth:replace-with-local-auth-password@127.0.0.1:5432/yizhi
YULIANG_REDIS_URL=redis://127.0.0.1:6379/0
YULIANG_BROKER_URL=amqp://yuliang:replace-with-local-broker-password@127.0.0.1:5672/yuliang
# 请在本地生成至少32字符随机值；不提供可直接运行的默认密钥。
YULIANG_SESSION_SECRET=
YULIANG_ALLOWED_ORIGINS=["http://localhost:3000"]
# F01联合接线前保持false；开启时需独立于SESSION_SECRET的审计密钥。
YULIANG_IDENTITY_API_ENABLED=false
YULIANG_AUTH_AUDIT_SECRET=
# 管理入口另行开放，默认只允许实际来源为回环IP，忽略客户端X-Forwarded-For。
YULIANG_ADMIN_API_ENABLED=false
YULIANG_ADMIN_ALLOWED_NETWORKS=["127.0.0.1/32","::1/128"]
# readyz/metrics只信真实连接来源；反代需另外配置可信入口。
YULIANG_OPERATIONS_ALLOWED_NETWORKS=["127.0.0.1/32","::1/128"]
