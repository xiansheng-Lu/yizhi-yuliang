# 复制到同目录.env.llm.local；不要提交真实值。不被默认应用自动加载。
YULIANG_LLM_PRIMARY_ENDPOINT=https://api.deepseek.com
YULIANG_LLM_PRIMARY_MODEL=deepseek-v4-flash
YULIANG_LLM_PRIMARY_KEY=
# 当前单模型，不隐式创建备用路由或自动重试；每次实际验证另需本地额度许可。

# ===== 文本生成可信价格（M3-16 账本硬要求：无真实单价不算闭环）=====
# 单位：元/千token；输入输出分开计，供应商账单页可查到
YULIANG_LLM_PRIMARY_PRICE_INPUT_PER_KTOK=
YULIANG_LLM_PRIMARY_PRICE_OUTPUT_PER_KTOK=

# ===== 图像生成供应商（M3-19a IMAGE/GRAPHIC 场景）=====
# 例：豆包视觉 https://ark.cn-beijing.volces.com/api/v3 ，模型 doubao-seedream-4-0
YULIANG_IMAGEGEN_PRIMARY_ENDPOINT=
YULIANG_IMAGEGEN_PRIMARY_MODEL=
YULIANG_IMAGEGEN_PRIMARY_KEY=
# 单位：元/次（单张图计费价，供应商账单页可查）
YULIANG_IMAGEGEN_PRIMARY_PRICE_PER_CALL=
# 调用限额：QPS 上限与每日额度，用于风控
YULIANG_IMAGEGEN_PRIMARY_QPS_LIMIT=
YULIANG_IMAGEGEN_PRIMARY_DAILY_QUOTA=

# ===== 视频生成供应商（M3-19a 视频场景，当前完全未接）=====
# 例：即梦 jimeng-video-3.0 或可灵 kling-v1-6
YULIANG_VIDEOGEN_PRIMARY_ENDPOINT=
YULIANG_VIDEOGEN_PRIMARY_MODEL=
YULIANG_VIDEOGEN_PRIMARY_KEY=
# 单位：元/秒（按时长计费）或 元/次（按次计费），供应商账单页可查
YULIANG_VIDEOGEN_PRIMARY_PRICE_PER_SECOND=
YULIANG_VIDEOGEN_PRIMARY_PRICE_PER_CALL=
YULIANG_VIDEOGEN_PRIMARY_QPS_LIMIT=
YULIANG_VIDEOGEN_PRIMARY_DAILY_QUOTA=
