+"""Explicit offline key initialization / plaintext migration. Never prints secrets."""
+import argparse
+import base64
+import csv
+import io
+import json
+import os
+import secrets
+import subprocess
+import sys
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from cache.security import ProcessOwner, SecureJSON
+
+
+def init_key(path, version):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    try:
+        # Tighten Windows ACL before writing key material (chmod alone is insufficient).
+        if os.name == "nt":
+            result = subprocess.run(["whoami", "/user", "/fo", "csv", "/nh"],
+                                    check=True, capture_output=True, text=True)
+            sid = next(csv.reader(io.StringIO(result.stdout)))[1]
+            subprocess.run(["icacls", str(path), "/inheritance:r", "/grant:r", "*" + sid + ":(F)"],
+                           check=True, capture_output=True)
+        with os.fdopen(fd, "w", encoding="utf-8") as stream:
+            fd = None
+            json.dump({version: base64.b64encode(secrets.token_bytes(32)).decode()}, stream)
+    finally:
+        if fd is not None:
+            os.close(fd)
+
+
+def migrate(path, context, owner_lock):
+    path = Path(path)
+    cipher = SecureJSON(context)
+    owner = ProcessOwner(owner_lock).acquire()
+    try:
+        payload = json.loads(path.read_text(encoding="utf-8"))
+        if payload.get("format") == "token-aesgcm-v1":
+            payload = cipher.read(path)  # Also permits explicit re-encryption to current key version.
+        elif not (isinstance(payload, dict) and ("accounts" in payload or "token" in payload)):
+            raise RuntimeError("源文件不是已知凭据或令牌快照，拒绝覆盖")
+        cipher.write(path, payload)
+        cipher.read(path)  # Authenticate the replaced envelope before reporting success.
+    finally:
+        owner.close()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest="command", required=True)
+    init = commands.add_parser("init-key")
+    init.add_argument("path")
+    init.add_argument("--version", default="v1")
+    migration = commands.add_parser("migrate")
+    migration.add_argument("path")
+    migration.add_argument("--context", required=True)
+    migration.add_argument("--owner-lock", required=True)
+    args = parser.parse_args()
+    if args.command == "init-key":
+        init_key(args.path, args.version)
+    else:
+        migrate(args.path, args.context, args.owner_lock)
+    print("完成；未输出密钥或令牌")
+
+
+if __name__ == "__main__":
+    main()
