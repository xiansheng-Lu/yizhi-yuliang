+class ProviderSecurityTests(unittest.TestCase):
+    def test_default_uses_service_and_does_not_fetch_direct_token(self):
+        with patch.dict(os.environ, WX_TOKEN_API_KEY="synthetic", WX_TOKEN_SERVICE_URL="http://127.0.0.1:8080"), \
+             patch("sdk.wxshop_client.requests.post") as post:
+            client = WxShopClient(appid="app", appsecret="synthetic-secret")
+            self.assertIsInstance(client.token_provider, ServiceTokenProvider)
+            post.assert_not_called()
+
+    def test_service_requires_key_and_secure_transport(self):
+        for url, key in (("http://127.0.0.1:8080", ""), ("http://remote.example.test", "key")):
+            with self.assertRaises(WxShopError):
+                ServiceTokenProvider(url, api_key=key)
+
+    def test_direct_provider_respects_actual_short_ttl(self):
+        provider = DirectTokenProvider("app", "synthetic", base_url="https://api.example.test")
+        response = Mock()
+        response.json.return_value = {"access_token":"token", "expires_in":20}
+        with patch("sdk.wxshop_client.time.time", return_value=100), \
+             patch("sdk.wxshop_client.requests.post", return_value=response) as post:
+            self.assertEqual(provider.get_token(), "token")
+            self.assertEqual(provider._expires_at, 120)
+            self.assertEqual(provider.get_token(), "token")
+            self.assertEqual(post.call_count, 1)
+        with patch("sdk.wxshop_client.time.time", return_value=111), \
+             patch("sdk.wxshop_client.requests.post", return_value=response) as post:
+            provider.get_token()
+            self.assertEqual(post.call_count, 1)
+
+    def test_invalid_ttl_rejected(self):
+        for ttl in (0, -1, None, "7200", True):
+            provider = DirectTokenProvider("app", "synthetic", base_url="https://api.example.test")
+            response = Mock()
+            response.json.return_value = {"access_token":"token", "expires_in":ttl}
+            with patch("sdk.wxshop_client.requests.post", return_value=response):
+                with self.assertRaises(WxShopError):
+                    provider.get_token()
+
+    def test_concurrent_direct_get_coalesces_even_when_token_unchanged(self):
+        provider = DirectTokenProvider("app", "synthetic", base_url="https://api.example.test")
+        def fetch(force_refresh=False):
+            time.sleep(0.02)
+            return "same-stable-token", 7200
+        with patch.object(provider, "_fetch", side_effect=fetch) as get:
+            with ThreadPoolExecutor(max_workers=20) as pool:
+                values = list(pool.map(lambda _: provider.get_token(), range(20)))
+            self.assertEqual(get.call_count, 1)
+            self.assertEqual(set(values), {"same-stable-token"})
