      "state": "PLANNED_REAL_TEST",
      "scenario": "空库upgrade head两次，无重复对象",
      "setup": "空的独立PG17库、迁移和普通角色",
      "action": "upgrade head两次并查询版本/对象计数",
      "expected": "对象不重复；第二次无增量DDL",
      "evidence": "迁移日志、alembic_version、对象计数"
    },
    {
      "id": "DB-I02",
      "task": "M0-07",
      "state": "PLANNED_REAL_TEST",
      "scenario": "A事务提交/异常回滚后连接给B，无上下文遗留",
      "setup": "租户A/B各一行，同一连接池",
      "action": "A事务正常提交和异常回滚后归还，B及无上下文事务各查询",
      "expected": "B只见B；无上下文不见业务；无法继承A",
      "evidence": "会话角色、事务ID、查询输出及连接复用记录"
    },
    {
      "id": "DB-I03",
      "task": "M0-08b",
