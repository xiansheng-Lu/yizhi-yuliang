NEXT_PUBLIC_DATA_MODE=api
# Set the independent backend origin, including any API prefix. No Tencent secrets belong here.
NEXT_PUBLIC_API_BASE_URL=
# Local UI preview only: explicitly set NEXT_PUBLIC_DATA_MODE=mock in .env.local.
# Set only after the backend owner confirms the snapshot endpoint rate limit.
# Empty = manual refresh in API mode. Milliseconds; effective cadence is never faster.
NEXT_PUBLIC_SNAPSHOT_MIN_INTERVAL_MS=
# Platform data freshness, independently configurable for each source (milliseconds).
# Align these with upstream publishing cadence and expected latency, not just polling.
NEXT_PUBLIC_LIVE_MAX_AGE_MS=45000
NEXT_PUBLIC_COMMERCE_MAX_AGE_MS=120000
NEXT_PUBLIC_TRENDS_MAX_AGE_MS=180000
NEXT_PUBLIC_TASKS_MAX_AGE_MS=30000
NEXT_PUBLIC_PLANS_MAX_AGE_MS=120000
